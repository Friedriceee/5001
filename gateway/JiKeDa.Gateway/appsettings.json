{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp.ReverseProxy": "Information"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "JiKeDa",
    "Audience": "JiKeDa.Client",
    "Key": "local-dev-only-jwt-signing-key-change-me-0123456789"
  },
  "ReverseProxy": {
    "Routes": {
      "identity-health": {
        "ClusterId": "identity",
        "Match": { "Path": "/health/identity" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "identity-auth": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "identity-accounts": {
        "ClusterId": "identity",
        "Match": { "Path": "/api/accounts/{**catch-all}" }
      },
      "catalog-health": {
        "ClusterId": "catalog",
        "Match": { "Path": "/health/catalog" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "catalog-api": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/catalog/{**catch-all}" }
      },
      "catalog-merchants": {
        "ClusterId": "catalog",
        "Match": { "Path": "/api/merchants/{**catch-all}" }
      },
      "order-health": {
        "ClusterId": "order",
        "Match": { "Path": "/health/order" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "order-cart": {
        "ClusterId": "order",
        "Match": { "Path": "/api/cart/{**catch-all}" }
      },
      "order-checkout": {
        "ClusterId": "order",
        "Match": { "Path": "/api/checkout/{**catch-all}" }
      },
      "order-api": {
        "ClusterId": "order",
        "Match": { "Path": "/api/orders/{**catch-all}" }
      },
      "fulfilment-health": {
        "ClusterId": "fulfilment",
        "Match": { "Path": "/health/fulfilment" },
        "Transforms": [ { "PathSet": "/health" } ]
      },
      "fulfilment-api": {
        "ClusterId": "fulfilment",
        "Match": { "Path": "/api/fulfilment/{**catch-all}" }
      },
      "delivery-api": {
        "ClusterId": "fulfilment",
        "Match": { "Path": "/api/deliveries/{**catch-all}" }
      },
      "rider-api": {
        "ClusterId": "fulfilment",
        "Match": { "Path": "/api/riders/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://identity:8080/" } }
      },
      "catalog": {
        "Destinations": { "primary": { "Address": "http://catalog:8080/" } }
      },
      "order": {
        "Destinations": { "primary": { "Address": "http://order:8080/" } }
      },
      "fulfilment": {
        "Destinations": { "primary": { "Address": "http://fulfilment:8080/" } }
      }
    }
  }
}
